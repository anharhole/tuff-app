      "title": "AdminRecord",
      "description": "Trusted server-managed administrator authorization marker document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 254 },
        "grantedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "UserPublicProfile": {
